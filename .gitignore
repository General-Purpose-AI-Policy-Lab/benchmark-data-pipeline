.DS_Store
__pycache__/
.ipynb_checkpoints/
.claude/

# Scale SEAL pages: no open license upstream (see NOTICE.md), so the captured
# HTML is not redistributed. `python -m benchmark_data refresh` fetches it before a build.
# Our own work over those pages stays tracked: seal/aliases.csv, the per-page
# sha256 in provenance.json, and the resulting scores in 2_database/scores.csv.
0_input/feed/seal/*.html

# Local environment and tool caches.
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/

# derived parity reports (python -m benchmark_data parity)
reports/

# Private feedback notes for Epoch AI, never committed.
EPOCH_FEEDBACK.md

# Local uv resolution, not part of the build.
uv.lock
